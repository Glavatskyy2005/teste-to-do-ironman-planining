# Copia este ficheiro para ".env" (ou define estas variáveis no teu serviço
# de alojamento) e preenche com os teus valores. NUNCA cometas o ".env" real
# para um repositório público nem o partilhes em conversa.

# Chave de API do intervals.icu — gera em:
# https://intervals.icu/settings -> Developer Settings -> API Key
INTERVALS_API_KEY=

# O teu ID de atleta no intervals.icu. Fica visível no URL do teu perfil,
# por exemplo intervals.icu/athlete/i123456 -> o ID é "i123456".
# Deixa "0" para usar automaticamente o atleta autenticado pela API key.
INTERVALS_ATHLETE_ID=0

# Token que vais colocar no cabeçalho Authorization ao registar este servidor
# como custom connector no Claude. Inventa uma string longa e aleatória.
MCP_AUTH_TOKEN=

# Porta onde o servidor HTTP vai ouvir (a maioria dos serviços de alojamento
# define isto automaticamente).
PORT=8000
